{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "probe",
      "camelcase": "Probe",
      "title": "Probe",
      "scope": "source.probe",
      "file-types": [
        "probe"
      ],
      "injection-regex": "^probe$",
      "class-name": "TreeSitterProbe"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Parser for Probe, a text-based API testing DSL built on HTTP syntax (RFC 9110/9112)",
    "authors": [
      {
        "name": "Charuka Karunanayake",
        "email": "charukakarunanayake@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/CharukaK/probe"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}