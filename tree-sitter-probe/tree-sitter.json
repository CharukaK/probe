{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "probe",
      "camelcase": "Probe",
      "title": "Probe",
      "scope": "source.probe",
      "file-types": [
        "probe"
      ],
      "injection-regex": "^probe$",
      "class-name": "TreeSitterProbe"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "Apache-2.0",
    "description": "Probe is a language for describing API requests",
    "authors": [
      {
        "name": "Charuka Karunanayake",
        "email": "charukakarunanayake@gmail.com",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/CharukaK/probe",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": true,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}