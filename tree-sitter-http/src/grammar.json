{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "http",
  "rules": {
    "source_file": {
      "type": "SYMBOL",
      "name": "request_block"
    },
    "_line_ending": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "\r\n"
        },
        {
          "type": "STRING",
          "value": "\n"
        }
      ]
    },
    "_wsp": {
      "type": "PATTERN",
      "value": "[ \\t]"
    },
    "_octet": {
      "type": "PATTERN",
      "value": "[\\s\\S]"
    },
    "digit": {
      "type": "PATTERN",
      "value": "[0-9]"
    },
    "http_version": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "HTTP/"
        },
        {
          "type": "FIELD",
          "name": "major",
          "content": {
            "type": "SYMBOL",
            "name": "digit"
          }
        },
        {
          "type": "STRING",
          "value": "."
        },
        {
          "type": "FIELD",
          "name": "minor",
          "content": {
            "type": "SYMBOL",
            "name": "digit"
          }
        }
      ]
    },
    "method": {
      "type": "PATTERN",
      "value": "[!#$%&'*+\\-.^_`|~0-9A-Za-z]+"
    },
    "field_name": {
      "type": "PATTERN",
      "value": "[!#$%&'*+\\-.^_`|~0-9A-Za-z]+"
    },
    "field_value": {
      "type": "PATTERN",
      "value": "[!-~]+(?:[ \\t]+[!-~]+)*"
    },
    "field_value_seperator": {
      "type": "STRING",
      "value": ":"
    },
    "request_target": {
      "type": "PATTERN",
      "value": "[!-~]+"
    },
    "request_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "method",
          "content": {
            "type": "SYMBOL",
            "name": "method"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_wsp"
        },
        {
          "type": "FIELD",
          "name": "target",
          "content": {
            "type": "SYMBOL",
            "name": "request_target"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_wsp"
                },
                {
                  "type": "FIELD",
                  "name": "version",
                  "content": {
                    "type": "SYMBOL",
                    "name": "http_version"
                  }
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_line_ending"
        }
      ]
    },
    "field_line": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "SYMBOL",
            "name": "field_name"
          }
        },
        {
          "type": "SYMBOL",
          "name": "field_value_seperator"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_wsp"
          }
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "field_value"
          }
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_wsp"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_line_ending"
        }
      ]
    },
    "request_body": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_octet"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "_line_ending"
        }
      ]
    },
    "request_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "request_line"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "REPEAT",
              "content": {
                "type": "SYMBOL",
                "name": "field_line"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SEQ",
              "members": [
                {
                  "type": "SYMBOL",
                  "name": "_line_ending"
                },
                {
                  "type": "SYMBOL",
                  "name": "request_body"
                }
              ]
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}